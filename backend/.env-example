HTTP_S=http://localhost
PUBLIC_URL=http://localhost:8080
PORT=8080
MODE=development

MONGODB_URL=mongodb://127.0.0.1:27017/News

# Use a long random value (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=REPLACE_ME
JWT_EXPIRE=1d

# Mail settings for the contact form (Gmail by default; see README "Contact form email")
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (SMTP_SECURE=false); 465 = implicit TLS (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
# SMTP login (SMTP_USER is accepted as an alias). Gmail only sends as this account.
SMTP_EMAIL=REPLACE_ME
# Gmail App Password (16 characters, needs 2-Step Verification). Leave empty until you create one.
SMTP_PASSWORD=
# Optional From address; defaults to SMTP_EMAIL. The visitor goes in Reply-To.
SMTP_FROM=
# Inbox that receives the contact-form messages
RECIPIENT_EMAIL=you@example.com

# Seeding (only used when the users collection is empty on startup).
# If unset, dev defaults are used (admin123 / user123) - always set these outside local dev.
SEED_ADMIN_PASSWORD=change-me-admin
SEED_USER_PASSWORD=change-me-user
